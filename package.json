{
  "name": "conjin-vscode",
  "displayName": "conjin-vscode",
  "publisher": "lucques",
  "license": "MIT",
  "description": "Conjin content page templates and embedded CSS and Markdown highlighting.",
  "homepage": "https://github.com/lucques/conjin-vscode",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucques/conjin-vscode.git"
  },
  "version": "0.0.3",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Snippets",
    "Programming Languages"
  ],
  "main": "./extension.js",
  "contributes": {
    "snippets": [
      {
        "language": "php",
        "path": "./snippets/conjin.json"
      }
    ],
    "commands": [
      {
        "command": "conjin.newPage",
        "title": "New Conjin Page",
        "category": "Conjin"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "conjin.newPage",
          "when": "explorerResourceIsFolder",
          "group": "navigation@20"
        }
      ]
    },
    "grammars": [
      {
        "injectTo": ["text.html.php"],
        "scopeName": "source.php.conjin-css",
        "path": "./syntaxes/php-css.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.environment": "php",
          "meta.embedded.block.css": "css"
        }
      },
      {
        "injectTo": ["text.html.php"],
        "scopeName": "source.php.conjin-md",
        "path": "./syntaxes/php-md.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.environment": "php",
          "meta.embedded.block.markdown": "markdown"
        }
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest:unit": "npm run lint",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test test/unit.test.js",
    "test:integration": "node ./test/run.js"
  },
  "devDependencies": {
    "@types/vscode": "~1.93.0",
    "@types/node": "^20.19.43",
    "eslint": "^10.11.0",
    "globals": "^17.12.0"
  }
}
